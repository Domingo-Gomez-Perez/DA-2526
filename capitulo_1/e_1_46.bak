#lang racket
(define (iterative-improve good-enough? improve)
  (lambda (guess)
    (if (good-enough? guess)
        guess
        ((iterative-improve good-enough? improve)
         (improve guess)))))

(define (sqrt x)
  ((iterative-improve
    (lambda (y) (< (abs (- (* y y) x)) 0.001)) ; test de convergencia
    (lambda (y) (/ (+ y (/ x y)) 2)))          ; mejora con Newton
   1.0)) ; guess inicial

(sqrt 9)   ; -> aproximadamente 3.0



(define (fixed-point f first-guess)
  ((iterative-improve
    (lambda (guess) (< (abs (- (f guess) guess)) 0.00001)) ; test de convergencia
    (lambda (guess) (f guess)))                           ; mejora = aplicar f
   first-guess))

(fixed-point cos 1.0)   ; -> ~0.739 (el punto fijo del coseno)